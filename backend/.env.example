# Copy this file to .env (in backend/) and fill in the values.
# Environment variables of the same name take precedence over this file.

# Required. Signs login tokens; at least 32 characters. Generate one in PowerShell with:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET_KEY=

# Optional. One-click demo login for the seeded demo accounts only.
# Leave false unless you are giving a demo; create the demo accounts first.
DEMO_MODE=false

# Optional. Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. A JDBC URL. Defaults to a SQLite file mathverse.db in this folder.
# DATABASE_URL=jdbc:sqlite:mathverse.db

# Optional. Lets an AI model rephrase Gwen's hints in character. Without it the
# game uses the built-in hints and works exactly the same.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
